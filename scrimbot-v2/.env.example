# Bot token. DISCORD_CLIENT_SECRET is also accepted (the old bot used that name).
DISCORD_TOKEN=

GUILD_ID=
# Channel that holds the "Regional Role Assignment" message
ROLE_CHANNEL=
# Optional. If empty, the bot looks for its own embed in ROLE_CHANNEL on startup.
ROLE_REACTION_MESSAGE_ID=
# Format: [emoji]![role id] separated by |
# Custom emoji are written name:id, unicode emoji are written as the emoji itself.
ROLE_MAPPING=CIS:111111111111111111!222222222222222222|🇪🇺!333333333333333333

# Who may use /rolepoll, /rolesync, /rolestatus besides server Administrators.
# Role IDs or role names, separated by |
ROLE_PERMISSION_ALLOWED_ROLES=Admin|Senior Moderator|Moderator

# Optional channel for error and sync notifications
NOTIFY_CHANNEL=

# add = on every start, give roles to people who reacted while the bot was offline
# off = do nothing on start
SYNC_ON_START=add

# Port for GET /healthz. 0 disables the health server.
HEALTH_PORT=8080
LOG_LEVEL=info
