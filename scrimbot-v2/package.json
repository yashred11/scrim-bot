{
  "name": "scrimbot",
  "version": "1.0.0",
  "description": "Regional role bot for the Dota 2 Scrims Discord server",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "e2e": "node --import tsx --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "ws": "^8.22.1"
  }
}
